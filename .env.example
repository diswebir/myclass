# نمونه تنظیمات محیطی. این فایل را به‌عنوان .env کپی نکنید مگر روی سرورهایی که متغیرهای محیطی ندارند.
# در cPanel مقادیر را در «Setup Node.js App > Environment variables» وارد کنید.
# هیچ رمز یا کلیدی را در این فایل ننویسید؛ مقادیر خالی یعنی «تنظیم نشده».

NODE_ENV=production
PORT=3000

# پایگاه داده (نام کامل پایگاه داده و کاربر، با پیشوند cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

# توکن نصب: فقط تا پایان نصب لازم است؛ پس از نصب حذف کنید.
INSTALL_TOKEN=

# پوشه خصوصی فایل‌ها (خالی = <ریشه برنامه>/storage). باید خارج از مسیر عمومی باشد.
STORAGE_DIR=

# نشست و کوکی
SESSION_TTL_HOURS=8
COOKIE_SECURE=true
TRUST_PROXY=1
