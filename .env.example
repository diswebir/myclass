# ============================================================================
# سامانه مدیریت مؤسسه آموزشی (ویژه هاست اشتراکی cPanel بدون SSH)
# فایل نمونه متغیرهای محیطی (.env.example)
# ============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# کلید رمزنگاری محرمانه نرم‌افزار (حداقل ۱۶ کاراکتر)
APP_SECRET=change_this_to_a_random_32_character_secret_string

# نام کوکی نشست
SESSION_COOKIE_NAME=myclass_session

# نوع پایگاه داده: برای پروداکشن cPanel مقدار mysql و برای تست سریع sqlite
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_academy
DB_PASSWORD=your_strong_mysql_password
DB_NAME=cpaneluser_academydb

# کلید محرمانه جهت اجرای امن پردازش پس‌زمینه (Cron Job) از طریق وب‌هوک
CRON_SECRET=generate_a_secret_token_for_cron_requests

# فعال‌سازی ارسال زنده پیامک (۰ = ارسال شبیه‌سازی‌شده تستی، ۱ = ارسال واقعی)
SMS_LIVE_TESTS=0
