# ============================================================
# myclass - .env.example
# هیچ‌گاه مقادیر واقعی (رمز/کلید) را در مخزن قرار ندهید.
# روی cPanel این متغیرها را در «Setup Node.js App > Environment variables» تنظیم کنید
# یا installer وب از شما می‌پرسد و فایل .env خارج از public_html می‌سازد.
# ============================================================

# محیط اجرا: development | production
NODE_ENV=production

# پورت/آدرس اپ (در cPanel معمولاً توسط Passenger مدیریت می‌شود)
PORT=3000
APP_BASE_URL=https://example.com

# اتصال پایگاه داده — installer هر دو را پشتیبانی می‌کند:
#   DB_DRIVER=mysql  → MariaDB/MySQL (پیشنهاد برای cPanel/هاستینگ اشتراکی — چند کاربر همزمان)
#   DB_DRIVER=sqlite → فایل SQLite (بدون سرور DB — مناسب تست/توسعه/نصب ساده)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myclass
DB_USER=myclass
DB_PASSWORD=change-me
# فقط برای DB_DRIVER=sqlite (پیش‌فرض installer: <STORAGE_DIR>/myclass.sqlite):
# DB_SQLITE_PATH=./storage/myclass.sqlite

# نشست‌ها
SESSION_SECRET=please-change-to-a-long-random-string
SESSION_TTL_HOURS=12
SESSION_IDLE_HOURS=2
COOKIE_SECURE=auto

# هش رمز عبور
BCRYPT_ROUNDS=12

# ذخیره‌سازی فایل‌ها (خارج از public_html؛ مسیر نسبی نسبت به روت پروژه)
STORAGE_DIR=../storage
UPLOAD_DIR=../storage/uploads
MAX_UPLOAD_MB=10

# رمزنگاری مقادیر حساس در DB (کلید ۶۴ کاراکتری hex؛ با دستور openssl rand -hex 32 بسازید)
ENCRYPTION_KEY=change-me-64-hex-chars

# installer
INSTALL_ALLOW_REINSTALL=0

# Rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# SMS (IPPanel) - کلید فقط سمت سرور؛ هرگز در UI/لاگ نمایش داده نمی‌شود
SMS_PROVIDER=ippanel
IP_PANEL_API_KEY=
IP_PANEL_BASE_URL=https://edge.ippanel.com/v1
SMS_LIVE_TESTS=0
SMS_CRON_TOKEN=

# فقط در محیط توسعه/تست: اجرای تست‌های یکپارچه‌سازی با SQLite
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=./.test-data/test.sqlite
