# ─────────────────────────────────────────────────────────────
# پیکربندی پلتفرم مدیریت کلاس | MyClass Platform
# این فایل پس از نصب وب‌محور به‌صورت خودکار ساخته می‌شود
# ─────────────────────────────────────────────────────────────

# محیط اجرا: production | development
NODE_ENV=production

# پورت (هاست سی‌پنل به‌صورت خودکار PORT را تنظیم می‌کند)
PORT=3000

# آدرس عمومی سایت (برای لینک‌های پیامکی و مدرک) — بدون اسلش انتهایی
APP_URL=https://example.com

# مسیر زیرپوشه (اختیاری) — اگر برنامه در زیرپوشه نصب شده مثل /myclass
BASE_PATH=

# کلید محرمانه جلسات (پس از نصب به‌صورت تصادفی ساخته می‌شود)
SESSION_SECRET=change-me

# ── پایگاه‌داده ─────────────────────────────────────────────
# sqlite (پیش‌فرض، بدون نیاز به تنظیم) یا mysql
DB_CLIENT=sqlite
DB_FILE=./data/myclass.sqlite

# تنظیمات MySQL / MariaDB (در صورت استفاده از DB_CLIENT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_myclass
DB_USER=cpaneluser
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── امنیت ────────────────────────────────────────────────────
# طول عمر جلسه به دقیقه
SESSION_TTL_MINUTES=720
# حداکثر تلاش ناموفق ورود قبل از قفل موقت
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15
# فعال‌سازی کوکی امن (فقط روی HTTPS فعال شود)
COOKIE_SECURE=false

# ── آپلود فایل ───────────────────────────────────────────────
UPLOAD_DIR=./public/uploads
MAX_UPLOAD_MB=8
