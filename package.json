{
  "name": "myclass",
  "version": "0.1.0",
  "description": "Institute management platform (Persian/RTL) for cPanel shared hosting",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node app.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/tests/unit/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/tests/integration/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.0",
    "sql.js": "^1.14.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.9.0"
  }
}
