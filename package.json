{
  "name": "myclass",
  "version": "0.1.0",
  "private": true,
  "description": "پلتفرم مدیریت مؤسسه آموزشی - قابل نصب روی هاست اشتراکی cPanel بدون SSH",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.migrations.json",
    "start": "node dist/index.js",
    "migrate": "node dist/core/db/migrate-cli.js",
    "job:sms": "node dist/jobs/run.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "alpinejs": "^3.14.9",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "bidi-js": "^1.0.3",
    "chart.js": "^4.4.7",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.2",
    "file-type": "^16.5.4",
    "fontkit": "^2.0.4",
    "helmet": "^8.0.0",
    "htmx.org": "^2.0.4",
    "jalaali-js": "^1.2.7",
    "kysely": "^0.27.4",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.11.5",
    "nunjucks": "^3.2.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/fontkit": "^2.0.9",
    "@types/jalaali-js": "^1.1.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nunjucks": "^3.2.6",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "harfbuzzjs": "^1.6.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
