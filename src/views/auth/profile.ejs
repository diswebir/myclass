<div class="profile-head">
  <div class="avatar"><%= (currentUser.first_name || '?').charAt(0) %></div>
  <div>
    <h2><%= currentUser.first_name %> <%= currentUser.last_name %></h2>
    <p><%= currentUser.role_title || '' %> — <%= currentUser.username %></p>
  </div>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-header"><h2><%= icon('user', 18) %> اطلاعات شخصی</h2></div>
    <div class="card-body">
      <form method="post" action="/panel/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">نام <span class="req">*</span></label>
            <input class="form-control" name="first_name" value="<%= currentUser.first_name %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">نام خانوادگی <span class="req">*</span></label>
            <input class="form-control" name="last_name" value="<%= currentUser.last_name %>" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">شماره موبایل</label>
            <input class="form-control" name="phone" value="<%= currentUser.phone || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">ایمیل</label>
            <input class="form-control" name="email" type="email" value="<%= currentUser.email || '' %>">
          </div>
        </div>
        <button class="btn btn-primary" type="submit"><%= icon('check', 18) %> ذخیره تغییرات</button>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2><%= icon('lock', 18) %> تغییر رمز عبور</h2></div>
    <div class="card-body">
      <form method="post" action="/panel/profile">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="first_name" value="<%= currentUser.first_name %>">
        <input type="hidden" name="last_name" value="<%= currentUser.last_name %>">
        <div class="form-group">
          <label class="form-label">رمز عبور فعلی</label>
          <input class="form-control" type="password" name="current_password" required>
        </div>
        <div class="form-group">
          <label class="form-label">رمز عبور جدید</label>
          <input class="form-control" type="password" name="new_password" minlength="8" required>
          <div class="form-hint">حداقل ۸ کاراکتر</div>
        </div>
        <div class="form-group">
          <label class="form-label">تکرار رمز عبور جدید</label>
          <input class="form-control" type="password" name="confirm_password" minlength="8" required>
        </div>
        <button class="btn btn-warning" type="submit"><%= icon('refresh', 18) %> تغییر رمز عبور</button>
      </form>
    </div>
  </div>
</div>
