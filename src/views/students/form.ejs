<div class="card">
  <div class="card-header">
    <h2><%= icon(isEdit ? 'edit' : 'user-plus', 18) %> <%= isEdit ? 'ویرایش دانش‌آموز' : 'افزودن دانش‌آموز' %></h2>
    <a href="<%= isEdit ? '/panel/students/' + student.id : '/panel/students' %>" class="btn btn-outline btn-sm">انصراف</a>
  </div>
  <div class="card-body">
    <form method="post" action="<%= isEdit ? '/panel/students/' + student.id : '/panel/students' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">نام <span class="req">*</span></label>
          <input class="form-control" name="first_name" value="<%= student.first_name || '' %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">نام خانوادگی <span class="req">*</span></label>
          <input class="form-control" name="last_name" value="<%= student.last_name || '' %>" required>
        </div>
      </div>

      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label">شماره موبایل</label>
          <input class="form-control" name="phone" dir="ltr" value="<%= student.phone || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">کد ملی</label>
          <input class="form-control" name="national_code" dir="ltr" value="<%= student.national_code || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">ایمیل</label>
          <input class="form-control" name="email" type="email" dir="ltr" value="<%= student.email || '' %>">
        </div>
      </div>

      <div class="divider"></div>
      <h3>اطلاعات تحصیلی</h3>

      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label">کد دانش‌آموزی</label>
          <input class="form-control" name="student_code" dir="ltr" value="<%= profile.student_code || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">تاریخ تولد</label>
          <input class="form-control" name="birth_date" data-jdp value="<%= profile.birth_date ? j.toJalali(profile.birth_date) : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">جنسیت</label>
          <select class="form-select" name="gender">
            <option value="">—</option>
            <option value="male" <%= profile.gender === 'male' ? 'selected' : '' %>>آقا</option>
            <option value="female" <%= profile.gender === 'female' ? 'selected' : '' %>>خانم</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">مقطع تحصیلی</label>
          <input class="form-control" name="education_level" value="<%= profile.education_level || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">مدرسه / محل تحصیل</label>
          <input class="form-control" name="school" value="<%= profile.school || '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">نام ولی / سرپرست</label>
          <input class="form-control" name="guardian_name" value="<%= profile.guardian_name || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">تلفن ولی</label>
          <input class="form-control" name="guardian_phone" dir="ltr" value="<%= profile.guardian_phone || '' %>">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">آدرس</label>
        <textarea class="form-control" name="address" rows="2"><%= profile.address || '' %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">یادداشت‌ها</label>
        <textarea class="form-control" name="notes" rows="2"><%= profile.notes || '' %></textarea>
      </div>

      <div class="divider"></div>
      <h3>حساب کاربری</h3>

      <% if (!isEdit) { %>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">نام کاربری</label>
            <input class="form-control" name="username" dir="ltr" placeholder="خودکار از شماره موبایل">
          </div>
          <div class="form-group">
            <label class="form-label">رمز عبور</label>
            <div class="input-group">
              <input class="form-control" type="text" name="password" id="genPass" dir="ltr" value="<%= generatedPassword %>">
              <button type="button" class="btn btn-outline" data-gen-password="genPass"><%= icon('refresh', 16) %></button>
            </div>
            <div class="form-hint">برای دانش‌آموز پیامک می‌شود</div>
          </div>
        </div>
      <% } else { %>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">رمز عبور جدید (اختیاری)</label>
            <input class="form-control" type="text" name="new_password" dir="ltr" placeholder="برای تغییر رمز">
          </div>
          <div class="form-group">
            <label class="form-label">وضعیت</label>
            <label class="switch">
              <input type="checkbox" name="is_active" <%= student.is_active ? 'checked' : '' %>>
              <span class="slider"></span>
              <span>حساب فعال باشد</span>
            </label>
          </div>
        </div>
      <% } %>

      <button class="btn btn-primary btn-lg" type="submit"><%= icon('check', 18) %> <%= isEdit ? 'ذخیره تغییرات' : 'ایجاد دانش‌آموز' %></button>
    </form>
  </div>
</div>
