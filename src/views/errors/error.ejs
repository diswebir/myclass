<!doctype html>
<html lang="fa" dir="rtl" data-theme="<%= s('appearance.default_theme', 'light') === 'dark' ? 'dark' : 'light' %>">
<head>
<% var title = 'خطا ' + status; %>
<%- include('../partials/head', { title }) %>
</head>
<body>
<div class="container container-sm" style="min-height:100vh;display:grid;place-items:center">
  <div class="card verify-card" style="width:100%">
    <div class="verify-icon <%= status === 404 ? '' : 'bad' %>" style="<%= status === 404 ? 'background:var(--primary-50);color:var(--primary)' : '' %>"><%- icon(status === 403 ? 'lock' : status === 404 ? 'search' : 'alert-triangle') %></div>
    <div class="fw-8" style="font-size:44px;line-height:1.2"><%= fa(status) %></div>
    <h2 class="mt-2"><%= status === 404 ? 'صفحه یافت نشد' : status === 403 ? 'عدم دسترسی' : status === 419 ? 'نشست منقضی شده' : 'خطایی رخ داد' %></h2>
    <p class="text-muted"><%= message %></p>
    <div class="flex gap-2 wrap" style="justify-content:center">
      <a class="btn btn-primary" href="<%= url(locals.user ? '/panel' : '/') %>"><%- icon('home', 'icon-sm') %>بازگشت به صفحه اصلی</a>
      <a class="btn" href="javascript:history.back()"><%- icon('arrow-right', 'icon-sm') %>بازگشت</a>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
