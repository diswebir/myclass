<div class="flex-between mb-3">
  <div>
    <h1 class="mt-0"><%= plan.title %></h1>
    <p class="text-soft mb-0">مبلغ کل: <strong><%= fmt.moneyFa(plan.total_amount, currencyLabel) %></strong></p>
  </div>
  <a href="/portal/payments" class="btn btn-outline"><%= icon('chevron-right', 16) %> بازگشت</a>
</div>

<div class="card">
  <div class="card-header"><h2><%= icon('calendar', 18) %> برنامه اقساط</h2></div>
  <div class="card-body">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>#</th><th>مبلغ</th><th>سررسید</th><th>وضعیت</th><th>تاریخ پرداخت</th></tr>
        </thead>
        <tbody>
          <% installments.forEach(function(i){ %>
            <tr>
              <td><%= fmt.numberFa(i.installment_no) %></td>
              <td class="nowrap"><strong><%= fmt.moneyFa(i.amount, currencyLabel) %></strong></td>
              <td class="nowrap"><%= i.due_date ? j.jalaliLong(i.due_date) : '—' %></td>
              <td><span class="badge badge-<%= fmt.statusClass(i.status) %>"><%= fmt.statusFa(i.status) %></span></td>
              <td class="nowrap"><%= i.paid_at ? j.jalaliLong(i.paid_at) : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="alert alert-info mt-3">
      <span>برای پرداخت هر قسط، می‌توانید از بخش «امور مالی من» رسید کارت به کارت خود را ثبت کنید یا حضوراً به موسسه مراجعه نمایید.</span>
    </div>
  </div>
</div>
