<div class="flex-between mb-3">
  <h1 class="mt-0">مدارک من</h1>
  <a href="/portal" class="btn btn-outline"><%= icon('chevron-right', 16) %> بازگشت</a>
</div>

<div class="card">
  <% if (certs.length === 0) { %>
    <div class="empty-state">
      <%= icon('award', 48) %>
      <h3>هنوز مدرکی برای شما صادر نشده است</h3>
      <p>پس از پایان دوره، مدرک شما صادر و در همین بخش نمایش داده می‌شود.</p>
    </div>
  <% } else { %>
    <div class="grid grid-3" style="padding:20px">
      <% certs.forEach(function(c){ %>
        <div class="card" style="margin:0">
          <div class="card-body text-center">
            <div style="width:58px;height:58px;border-radius:18px;background:var(--accent-soft);color:var(--accent);display:inline-flex;align-items:center;justify-content:center">
              <%= icon('award', 30) %>
            </div>
            <h3 class="mt-2"><%= c.class_title %></h3>
            <p class="text-muted" dir="ltr"><%= c.serial %></p>
            <div class="flex gap-2" style="justify-content:center">
              <a class="btn btn-primary btn-sm" target="_blank" href="/panel/certificates/<%= c.id %>/print"><%= icon('printer', 14) %> چاپ</a>
              <a class="btn btn-outline btn-sm" target="_blank" href="/verify/<%= c.serial %>"><%= icon('eye', 14) %> استعلام</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>
