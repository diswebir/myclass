<div class="flex-between mb-3">
  <div>
    <h1 class="mt-0"><%= plan.title %></h1>
    <p class="text-soft mb-0"><%= plan.first_name %> <%= plan.last_name %><% if (plan.class_title) { %> — <%= plan.class_title %><% } %></p>
  </div>
  <a href="/panel/payments/installments/plans" class="btn btn-outline"><%= icon('chevron-right', 16) %> بازگشت</a>
</div>

<div class="card">
  <div class="card-header">
    <h2><%= icon('file-text', 18) %> اقساط</h2>
    <div class="flex gap-2">
      <% if (can('payments.manage')) { %>
        <form method="post" action="/panel/payments/installments/remind">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="days" value="3">
          <button class="btn btn-warning btn-sm" type="submit"><%= icon('send', 14) % یادآوری سررسیدها</button>
        </form>
      <% } %>
    </div>
  </div>
  <div class="card-body">
    <dl class="kv mb-3">
      <dt>مبلغ کل</dt><dd><%= fmt.moneyFa(plan.total_amount, currencyLabel) %></dd>
      <dt>تعداد اقساط</dt><dd><%= fmt.numberFa(plan.installments_count) %></dd>
      <dt>اولین سررسید</dt><dd><%= plan.start_due_date ? j.jalaliLong(plan.start_due_date) : '—' %></dd>
      <dt>وضعیت</dt><dd><span class="badge badge-<%= fmt.statusClass(plan.status) %>"><%= fmt.statusFa(plan.status) %></span></dd>
    </dl>

    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr><th>#</th><th>مبلغ</th><th>سررسید</th><th>وضعیت</th><th>تاریخ پرداخت</th><th></th></tr>
        </thead>
        <tbody>
          <% installments.forEach(function(i){ %>
            <tr>
              <td><%= fmt.numberFa(i.installment_no) %></td>
              <td class="nowrap"><strong><%= fmt.moneyFa(i.amount, currencyLabel) %></strong></td>
              <td class="nowrap"><%= i.due_date ? j.jalaliLong(i.due_date) : '—' %></td>
              <td><span class="badge badge-<%= fmt.statusClass(i.status) %>"><%= fmt.statusFa(i.status) %></span></td>
              <td class="nowrap"><%= i.paid_at ? j.jalaliLong(i.paid_at) : '—' %></td>
              <td>
                <% if (i.status !== 'paid' && can('payments.manage')) { %>
                  <form method="post" action="/panel/payments/installments/<%= i.id %>/pay" class="flex gap-2">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select class="form-select" name="method" style="min-width:110px">
                      <option value="cash">نقدی</option>
                      <option value="card_to_card">کارت به کارت</option>
                    </select>
                    <button class="btn btn-success btn-sm" type="submit"><%= icon('check', 14) % ثبت پرداخت</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
