<div class="card">
  <div class="card-header">
    <h2><%= icon(isEdit ? 'edit' : 'user-plus', 18) %> <%= isEdit ? 'ویرایش استاد' : 'افزودن استاد' %></h2>
    <a href="<%= isEdit ? '/panel/teachers/' + teacher.id : '/panel/teachers' %>" class="btn btn-outline btn-sm">انصراف</a>
  </div>
  <div class="card-body">
    <form method="post" action="<%= isEdit ? '/panel/teachers/' + teacher.id : '/panel/teachers' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">نام <span class="req">*</span></label>
          <input class="form-control" name="first_name" value="<%= teacher.first_name || '' %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">نام خانوادگی <span class="req">*</span></label>
          <input class="form-control" name="last_name" value="<%= teacher.last_name || '' %>" required>
        </div>
      </div>

      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label">شماره موبایل</label>
          <input class="form-control" name="phone" dir="ltr" value="<%= teacher.phone || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">ایمیل</label>
          <input class="form-control" name="email" type="email" dir="ltr" value="<%= teacher.email || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">کد ملی</label>
          <input class="form-control" name="national_code" dir="ltr" value="<%= teacher.national_code || '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">تخصص</label>
          <input class="form-control" name="expertise" value="<%= profile.expertise || '' %>" placeholder="مثال: ریاضیات تحلیلی">
        </div>
        <div class="form-group">
          <label class="form-label">تاریخ شروع همکاری</label>
          <input class="form-control" name="hire_date" data-jdp value="<%= profile.hire_date ? j.toJalali(profile.hire_date) : '' %>">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">بیوگرافی</label>
        <textarea class="form-control" name="bio" rows="3"><%= profile.bio || '' %></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">یادداشت‌ها</label>
        <textarea class="form-control" name="notes" rows="2"><%= profile.notes || '' %></textarea>
      </div>

      <div class="divider"></div>
      <h3>حساب کاربری</h3>

      <% if (!isEdit) { %>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">نام کاربری <span class="req">*</span></label>
            <input class="form-control" name="username" dir="ltr" required>
          </div>
          <div class="form-group">
            <label class="form-label">رمز عبور</label>
            <div class="input-group">
              <input class="form-control" type="text" name="password" id="genPass" dir="ltr" value="<%= generatedPassword %>">
              <button type="button" class="btn btn-outline" data-gen-password="genPass"><%= icon('refresh', 16) %></button>
            </div>
          </div>
        </div>
      <% } else { %>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">رمز عبور جدید (اختیاری)</label>
            <input class="form-control" type="text" name="new_password" dir="ltr">
          </div>
          <div class="form-group">
            <label class="form-label">وضعیت</label>
            <label class="switch">
              <input type="checkbox" name="is_active" <%= teacher.is_active ? 'checked' : '' %>>
              <span class="slider"></span>
              <span>حساب فعال باشد</span>
            </label>
          </div>
        </div>
      <% } %>

      <button class="btn btn-primary btn-lg" type="submit"><%= icon('check', 18) %> <%= isEdit ? 'ذخیره تغییرات' : 'ایجاد استاد' %></button>
    </form>
  </div>
</div>
