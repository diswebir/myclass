<div class="card">
  <div class="card-header">
    <h2><%= icon(isEdit ? 'edit' : 'plus', 18) %> <%= isEdit ? 'ویرایش کلاس' : 'کلاس جدید' %></h2>
    <a href="<%= isEdit ? '/panel/classes/' + cls.id : '/panel/classes' %>" class="btn btn-outline btn-sm">انصراف</a>
  </div>
  <div class="card-body">
    <form method="post" action="<%= isEdit ? '/panel/classes/' + cls.id : '/panel/classes' %>" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">عنوان کلاس <span class="req">*</span></label>
          <input class="form-control" name="title" value="<%= cls.title || '' %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">کد کلاس</label>
          <input class="form-control" name="code" dir="ltr" value="<%= cls.code || '' %>" placeholder="خودکار تولید می‌شود">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">توضیحات</label>
        <textarea class="form-control" name="description" rows="4"><%= cls.description || '' %></textarea>
      </div>

      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label">دسته‌بندی</label>
          <input class="form-control" name="category" value="<%= cls.category || '' %>" placeholder="مثال: ریاضی">
        </div>
        <div class="form-group">
          <label class="form-label">سطح</label>
          <input class="form-control" name="level" value="<%= cls.level || '' %>" placeholder="مثال: مقدماتی">
        </div>
        <div class="form-group">
          <label class="form-label">استاد</label>
          <select class="form-select" name="teacher_id">
            <option value="">— انتخاب کنید —</option>
            <% teachers.forEach(function(t){ %>
              <option value="<%= t.id %>" <%= String(cls.teacher_id) === String(t.id) ? 'selected' : '' %>>
                <%= t.first_name %> <%= t.last_name %>
              </option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label">ظرفیت</label>
          <input class="form-control" type="number" name="capacity" value="<%= cls.capacity || 20 %>" min="1">
        </div>
        <div class="form-group">
          <label class="form-label">شهریه (<%= currencyLabel %>)</label>
          <input class="form-control" type="number" name="price" value="<%= cls.price || 0 %>" min="0" data-money-preview="pricePreview">
          <div class="form-hint">معادل: <strong id="pricePreview">—</strong></div>
        </div>
        <div class="form-group">
          <label class="form-label">تعداد اقساط پیش‌فرض</label>
          <input class="form-control" type="number" name="installments_count" value="<%= cls.installments_count || 1 %>" min="1">
        </div>
      </div>

      <div class="divider"></div>
      <h3><%= icon('calendar', 18) %> برنامه زمانی</h3>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">تاریخ شروع</label>
          <input class="form-control" name="start_date" data-jdp value="<%= cls.start_date ? j.toJalali(cls.start_date) : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">تاریخ پایان</label>
          <input class="form-control" name="end_date" data-jdp value="<%= cls.end_date ? j.toJalali(cls.end_date) : '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">ساعت شروع</label>
          <input class="form-control" type="time" name="start_time" value="<%= cls.start_time ? String(cls.start_time).slice(0,5) : '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">ساعت پایان</label>
          <input class="form-control" type="time" name="end_time" value="<%= cls.end_time ? String(cls.end_time).slice(0,5) : '' %>">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">روزهای برگزاری</label>
        <div class="flex gap-2" style="flex-wrap:wrap">
          <%
            var selectedDays = String(cls.days_of_week || '').split(',');
            weekdays.forEach(function(w){
          %>
            <label class="chip" style="cursor:pointer">
              <input type="checkbox" name="days_of_week" value="<%= w.value %>"
                     <%= selectedDays.indexOf(String(w.value)) !== -1 ? 'checked' : '' %>>
              <%= w.label %>
            </label>
          <% }); %>
        </div>
        <div class="form-hint">پس از ذخیره، از دکمه «تولید خودکار جلسات» در صفحه کلاس استفاده کنید.</div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label">مکان برگزاری</label>
          <input class="form-control" name="location" value="<%= cls.location || '' %>">
        </div>
        <div class="form-group">
          <label class="form-label">تصویر کلاس</label>
          <input class="form-control" type="file" name="image_file" accept="image/*">
        </div>
      </div>

      <div class="divider"></div>
      <div class="form-row-3">
        <div class="form-group">
          <label class="form-label">وضعیت</label>
          <select class="form-select" name="status">
            <option value="draft" <%= cls.status === 'draft' ? 'selected' : '' %>>پیش‌نویس</option>
            <option value="open" <%= cls.status === 'open' ? 'selected' : '' %>>ثبت‌نام باز</option>
            <option value="in_progress" <%= cls.status === 'in_progress' ? 'selected' : '' %>>در حال برگزاری</option>
            <option value="completed" <%= cls.status === 'completed' ? 'selected' : '' %>>پایان‌یافته</option>
            <option value="cancelled" <%= cls.status === 'cancelled' ? 'selected' : '' %>>لغو شده</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">نمره قبولی</label>
          <input class="form-control" type="number" step="0.25" name="passing_score" value="<%= cls.passing_score || 10 %>">
        </div>
        <div class="form-group">
          <label class="form-label">صدور مدرک</label>
          <label class="switch">
            <input type="checkbox" name="certificate_enabled" <%= cls.certificate_enabled ? 'checked' : '' %>>
            <span class="slider"></span>
            <span>فعال</span>
          </label>
        </div>
      </div>

      <button class="btn btn-primary btn-lg" type="submit"><%= icon('check', 18) %> <%= isEdit ? 'ذخیره تغییرات' : 'ایجاد کلاس' %></button>
    </form>
  </div>
</div>
