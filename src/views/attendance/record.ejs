<div class="flex-between mb-3">
  <div>
    <h1 class="mt-0"><%= session.class_title %></h1>
    <p class="text-soft mb-0">
      <%= icon('calendar', 16) %> <%= j.jalaliLong(session.session_date) %> <%= j.weekdayName(session.session_date) %>
      <% if (session.start_time) { %> — <%= icon('clock', 16) %> <%= j.timeFa(session.start_time) %> تا <%= j.timeFa(session.end_time) %><% } %>
    </p>
  </div>
  <a href="/panel/attendance" class="btn btn-outline"><%= icon('chevron-right', 16) %> بازگشت</a>
</div>

<div class="card">
  <div class="card-header">
    <h2><%= icon('check-square', 18) %> لیست حضور و غیاب</h2>
    <span class="chip"><%= fmt.numberFa(students.length) %> دانش‌آموز</span>
  </div>
  <div class="card-body">
    <% if (students.length === 0) { %>
      <div class="empty-state"><p>این کلاس دانش‌آموزی ندارد.</p></div>
    <% } else { %>
      <form method="post" action="/panel/attendance/session/<%= session.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th>#</th><th>نام</th><th>کد دانش‌آموزی</th><th>وضعیت حضور</th><th>یادداشت</th></tr>
            </thead>
            <tbody>
              <% students.forEach(function(st, i){ %>
                <tr>
                  <td><%= fmt.numberFa(i + 1) %></td>
                  <td><strong><%= st.first_name %> <%= st.last_name %></strong></td>
                  <td dir="ltr"><%= st.student_code || '—' %></td>
                  <td>
                    <div class="att-group" data-student="<%= st.student_id %>">
                      <input type="hidden" name="status[<%= st.student_id %>]" value="<%= st.att_status || 'present' %>">
                      <button type="button" class="att-btn <%= (st.att_status || 'present') === 'present' ? 'on-present' : '' %>" data-value="present">حاضر</button>
                      <button type="button" class="att-btn <%= st.att_status === 'absent' ? 'on-absent' : '' %>" data-value="absent">غایب</button>
                      <button type="button" class="att-btn <%= st.att_status === 'late' ? 'on-late' : '' %>" data-value="late">تاخیر</button>
                      <button type="button" class="att-btn <%= st.att_status === 'excused' ? 'on-excused' : '' %>" data-value="excused">موجه</button>
                    </div>
                  </td>
                  <td>
                    <input class="form-control" name="note[<%= st.student_id %>]" value="<%= st.note || '' %>" placeholder="اختیاری" style="min-width:120px">
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <div class="flex-between mt-3">
          <label class="form-check">
            <input type="checkbox" name="send_absence_sms" value="1">
            <span>ارسال پیامک اطلاع غیبت برای غایبان</span>
          </label>
          <button class="btn btn-primary btn-lg" type="submit"><%= icon('check', 18) %> ذخیره حضور و غیاب</button>
        </div>
      </form>
    <% } %>
  </div>
</div>
