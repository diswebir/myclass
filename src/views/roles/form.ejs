<div class="flex-between mb-3">
  <h1 class="mt-0"><%= isEdit ? 'ویرایش سطح دسترسی: ' + role.title : 'سطح دسترسی جدید' %></h1>
  <a href="/panel/roles" class="btn btn-outline"><%= icon('chevron-right', 16) %> بازگشت</a>
</div>

<form method="post" action="<%= isEdit ? '/panel/roles/' + role.id : '/panel/roles' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <div class="card-header"><h2><%= icon('shield', 18) %> اطلاعات نقش</h2></div>
    <div class="card-body">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">عنوان <span class="req">*</span></label>
          <input class="form-control" name="title" value="<%= role.title %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">توضیحات</label>
          <input class="form-control" name="description" value="<%= role.description || '' %>">
        </div>
      </div>
      <label class="switch">
        <input type="checkbox" name="is_active" <%= role.is_active ? 'checked' : '' %>>
        <span class="slider"></span>
        <span>این نقش فعال باشد</span>
      </label>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2><%= icon('lock', 18) %> ماتریس دسترسی‌ها</h2>
      <div class="flex gap-2">
        <button type="button" class="btn btn-outline btn-sm" onclick="toggleAll(true)">انتخاب همه</button>
        <button type="button" class="btn btn-outline btn-sm" onclick="toggleAll(false)">حذف همه</button>
      </div>
    </div>
    <div class="card-body">
      <%
        var grouped = {};
        perms.forEach(function(p){
          var key = p.module_title || p.module_code;
          if (!grouped[key]) grouped[key] = [];
          grouped[key].push(p);
        });
      %>
      <div class="grid grid-3">
        <% Object.keys(grouped).forEach(function(g){ %>
          <div>
            <h3 style="font-size:0.95rem;color:var(--accent)"><%= g %></h3>
            <% grouped[g].forEach(function(p){ %>
              <label class="form-check">
                <input type="checkbox" name="perms" value="<%= p.code %>"
                       <%= rolePerms.has(p.id) ? 'checked' : '' %>>
                <span><%= p.title %></span>
              </label>
            <% }); %>
          </div>
        <% }); %>
      </div>
    </div>
    <div class="card-footer">
      <button class="btn btn-primary btn-lg" type="submit"><%= icon('check', 18) %> ذخیره سطح دسترسی</button>
    </div>
  </div>
</form>

<script>
function toggleAll(state) {
  document.querySelectorAll('input[name="perms"]').forEach(function (cb) {
    cb.checked = state;
  });
}
</script>
