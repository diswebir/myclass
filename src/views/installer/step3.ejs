<div class="install-steps">
  <div class="install-step done">۱. بررسی پیش‌نیازها</div>
  <div class="install-step done">۲. پایگاه‌داده</div>
  <div class="install-step active">۳. موسسه و مدیر</div>
  <div class="install-step">۴. پایان</div>
</div>

<h2 style="font-size:1.15rem">اطلاعات موسسه و حساب مدیر</h2>

<% if (error) { %><div class="alert alert-danger"><span><%= error %></span></div><% } %>

<form method="post" action="/install/admin">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <h3 class="mt-0">اطلاعات موسسه</h3>
  <div class="form-group">
    <label class="form-label">نام موسسه <span class="req">*</span></label>
    <input class="form-control" name="institute_name" value="<%= typeof values !== 'undefined' ? values.institute_name || '' : '' %>" required>
  </div>
  <div class="form-group">
    <label class="form-label">تلفن موسسه</label>
    <input class="form-control" name="institute_phone" value="<%= typeof values !== 'undefined' ? values.institute_phone || '' : '' %>">
  </div>

  <div class="divider"></div>
  <h3>حساب مدیر (ناظر کل)</h3>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label">نام <span class="req">*</span></label>
      <input class="form-control" name="first_name" required>
    </div>
    <div class="form-group">
      <label class="form-label">نام خانوادگی <span class="req">*</span></label>
      <input class="form-control" name="last_name" required>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label">نام کاربری <span class="req">*</span></label>
      <input class="form-control" name="username" required pattern="[a-zA-Z0-9_.]{3,50}" dir="ltr">
    </div>
    <div class="form-group">
      <label class="form-label">شماره موبایل</label>
      <input class="form-control" name="phone" dir="ltr">
    </div>
  </div>
  <div class="form-group">
    <label class="form-label">رمز عبور <span class="req">*</span></label>
    <input class="form-control" type="password" name="password" minlength="8" required>
    <div class="form-hint">حداقل ۸ کاراکتر</div>
  </div>

  <div class="divider"></div>
  <h3>پیامک (اختیاری)</h3>
  <p class="form-hint mt-0">می‌توانید بعداً از بخش تنظیمات نیز پیکربندی کنید.</p>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label">کلید دسترسی IPPanel (API Key)</label>
      <input class="form-control" name="sms_api_key" dir="ltr" placeholder="Access Key از پنل IPPanel">
    </div>
    <div class="form-group">
      <label class="form-label">شماره فرستنده</label>
      <input class="form-control" name="sms_from_number" dir="ltr" value="+983000505">
    </div>
  </div>

  <button class="btn btn-primary btn-block btn-lg" type="submit"><%= icon('check', 18) %> تکمیل نصب</button>
</form>
