{% extends "layout.njk" %}
{% block title %}پیش‌سبت‌نام سبت شد{% endblock %}
{% block content %}
<div class="card">
  <h1>✅ پیش‌سبت‌نام شما سبت شد</h1>
  <p>کد پیگیری: <code style="font-size:1.3rem">{{ trackingCode }}</code></p>
  <p>کلاس: {{ cls.title }}</p>
  <p>برای پیگیری وضعیت، این کد را نگه دارید: <a href="/prereg/tracking/{{ trackingCode }}">پیگیری</a></p>
</div>
{% endblock %}
