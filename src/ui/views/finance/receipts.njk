{% extends "layout.njk" %}
{% block title %}رسیدهای کارت‌به‌کارت — myclass{% endblock %}
{% block content %}
{% set statusLabels = { 'pending': 'در انتظار', 'approved': 'تأییدشده', 'rejected': 'ردشده' } %}
<div class="page-head">
  <h1>رسیدهای کارت‌به‌کارت</h1>
  <a href="/finance/payments" class="btn btn-ghost">پرداخت‌ها</a>
</div>
<div class="card">
  <form method="get" class="grid2">
    <div class="field"><label>وضعیت</label>
      <select name="status">
        <option value="">همه</option>
        {% for k, v in statusLabels %}<option value="{{ k }}" {{ 'selected' if filters.status == k }}>{{ v }}</option>{% endfor %}
      </select>
    </div>
    <div class="actions"><button type="submit" class="btn btn-primary">فیلتر</button></div>
  </form>
</div>
<table class="table">
  <thead><tr><th>کد</th><th>فراگیر</th><th>مبلغ</th><th>رسید</th><th>وضعیت</th><th>تاریخ</th><th>عملیات</th></tr></thead>
  <tbody>
    {% for r in rows %}
    <tr>
      <td>{{ r.id | faNum }}</td>
      <td>{{ r.first_name }} {{ r.last_name }} ({{ r.student_code }})</td>
      <td>{{ r.amount | faMoney }}</td>
      <td><a href="/files/{{ r.file_id }}" target="_blank" class="btn btn-sm btn-ghost">مشاهده</a></td>
      <td><span class="badge {{ 'ok' if r.status == 'approved' else ('fail' if r.status == 'rejected' else '') }}">{{ statusLabels[r.status] or r.status }}</span></td>
      <td>{{ r.created_at | faDateTime }}</td>
      <td>
        {% if r.status == 'pending' %}
        <form method="post" action="/finance/receipts/{{ r.id }}/review" class="inline-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="action" value="approve">
          <button type="submit" class="btn btn-sm btn-primary">تأیید</button>
        </form>
        <form method="post" action="/finance/receipts/{{ r.id }}/review" class="inline-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="action" value="reject">
          <input type="hidden" name="note" value="رسید نامعتبر">
          <button type="submit" class="btn btn-sm btn-ghost">رد</button>
        </form>
        {% elif r.review_note %}
        <small>{{ r.review_note }}</small>
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="7" class="empty">رسیدی یافت نشد.</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
