{% extends "layout.njk" %}
{% block title %}{{ 'ویرایش فراگیر' if student else 'فراگیر جدید' }} — myclass{% endblock %}
{% block content %}
<div class="card">
  <h1>{{ 'ویرایش فراگیر' if student else 'فراگیر جدید' }}</h1>
  <form method="post" action="{{ '/students/' + student.id if student else '/students' }}">
    {% if student %}<input type="hidden" name="_method" value="put">{% endif %}
    <div class="grid2">
      <div class="field"><label>کد دانشجویی</label><input name="code" value="{{ student.code if student else '' }}" required></div>
      <div class="field"><label>نام</label><input name="firstName" value="{{ student.first_name if student else '' }}" required></div>
      <div class="field"><label>نام خانوادگی</label><input name="lastName" value="{{ student.last_name if student else '' }}" required></div>
      <div class="field"><label>موبایل</label><input name="phone" value="{{ student.phone if student else '' }}" required></div>
      <div class="field"><label>ایمیل</label><input type="email" name="email" value="{{ student.email if student else '' }}"></div>
      <div class="field"><label>کد ملی</label><input name="nationalId" value="{{ student.national_id if student else '' }}"></div>
      <div class="field"><label>نام سرپرست</label><input name="guardianName" value="{{ student.guardian_name if student else '' }}"></div>
      <div class="field"><label>موبایل سرپرست</label><input name="guardianPhone" value="{{ student.guardian_phone if student else '' }}"></div>
      <div class="field"><label>تاریخ تولد (شمسی)</label><input name="birthDate" value="{{ student.birth_date | faDate if student else '' }}" placeholder="۱۳۹۰/۰۵/۱۵"></div>
    </div>
    <div class="field"><label>یادداشت</label><textarea name="notes" rows="3">{{ student.notes if student else '' }}</textarea></div>
    <div class="actions">
      <button type="submit" class="btn btn-primary">ذخیره</button>
      <a href="/students" class="btn btn-ghost">بازگشت</a>
    </div>
  </form>
</div>
{% endblock %}
