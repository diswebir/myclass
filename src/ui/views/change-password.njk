{% extends "layout.njk" %}
{% block title %}تغییر رمز — myclass{% endblock %}
{% block content %}
<div class="card">
  <h1>تغییر رمز عبور</h1>
  {% if forced %}<div class="alert alert-warn">برای ادامه باید رمز عبور خود را تغییر دهید.</div>{% endif %}
  {% if error %}<div class="alert alert-error">{{ error }}</div>{% endif %}
  {% if success %}<div class="alert alert-ok">{{ success }}</div>{% endif %}
  <form method="post" action="/auth/change-password">
    <input type="hidden" name="force" value="{{ '1' if forced else '0' }}">
    <div class="field">
      <label for="currentPassword">رمز عبور فعلی</label>
      <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
    </div>
    <div class="field">
      <label for="newPassword">رمز عبور جدید</label>
      <input type="password" id="newPassword" name="newPassword" required autocomplete="new-password">
    </div>
    <div class="field">
      <label for="confirmPassword">تکرار رمز عبور جدید</label>
      <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password">
    </div>
    <button type="submit" class="btn btn-primary">تغییر رمز</button>
  </form>
</div>
{% endblock %}
