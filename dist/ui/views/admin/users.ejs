<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="color: #1e3a8a;">مدیریت کاربران، نقش‌ها و سطوح دسترسی (RBAC)</h2>
    <p style="color: #64748b;">تعریف حساب‌های کاربری پرسنل و تنظیم دسترسی‌های گرانولار</p>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
  <!-- ایجاد کاربر جدید -->
  <div class="card">
    <h3 style="margin-bottom: 1rem; color: #1e3a8a;">➕ ایجاد حساب کاربری پرسنل / ادمین</h3>
    <form method="POST" action="/admin/users/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="fullName">نام و نام خانوادگی</label>
        <input type="text" id="fullName" name="fullName" required placeholder="محمد کاظمی">
      </div>
      <div class="form-group">
        <label for="mobile">شماره همراه (نام کاربری)</label>
        <input type="text" id="mobile" name="mobile" required placeholder="۰۹۱۲۳۴۵۶۷۸۹">
      </div>
      <div class="form-group">
        <label for="password">کلمه عبور</label>
        <input type="password" id="password" name="password" required minlength="8" placeholder="حداقل ۸ کاراکتر">
      </div>
      <div class="form-group">
        <label for="roleId">نقش کاربری</label>
        <select id="roleId" name="roleId" required>
          <% roles.forEach(r => { %>
            <option value="<%= r.id %>"><%= r.title_fa %> (<%= r.name %>)</option>
          <% }); %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">ثبت کاربر جدید</button>
    </form>
  </div>

  <!-- ایجاد نقش جدید -->
  <div class="card">
    <h3 style="margin-bottom: 1rem; color: #1e3a8a;">🛡️ تعریف نقش سفارشی جدید</h3>
    <form method="POST" action="/admin/roles/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="roleName">شناسه انگلیسی نقش</label>
        <input type="text" id="roleName" name="name" required placeholder="مثال: finance_clerk">
      </div>
      <div class="form-group">
        <label for="titleFa">عنوان فارسی نقش</label>
        <input type="text" id="titleFa" name="titleFa" required placeholder="مثال: کارشناس مالی">
      </div>
      <div class="form-group">
        <label>دسترسی‌های مجاز:</label>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; max-height: 150px; overflow-y: auto; padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 6px;">
          <label><input type="checkbox" name="permissions" value="classes.read"> مشاهده کلاس‌ها</label>
          <label><input type="checkbox" name="permissions" value="classes.write"> ایجاد/ویرایش کلاس</label>
          <label><input type="checkbox" name="permissions" value="students.read"> مشاهده فراگیران</label>
          <label><input type="checkbox" name="permissions" value="students.write"> ثبت فراگیر</label>
          <label><input type="checkbox" name="permissions" value="attendance.read"> مشاهده حضور غیاب</label>
          <label><input type="checkbox" name="permissions" value="attendance.record"> ثبت حضور غیاب</label>
          <label><input type="checkbox" name="permissions" value="finance.read"> مشاهده مالی</label>
          <label><input type="checkbox" name="permissions" value="finance.record_payment"> ثبت پرداخت</label>
          <label><input type="checkbox" name="permissions" value="finance.review_receipts"> بررسی فیش‌ها</label>
          <label><input type="checkbox" name="permissions" value="certificates.read"> مشاهده مدارک</label>
          <label><input type="checkbox" name="permissions" value="certificates.issue"> صدور مدارک</label>
        </div>
      </div>
      <button type="submit" class="btn btn-secondary" style="width: 100%;">ایجاد نقش جدید</button>
    </form>
  </div>
</div>

<!-- جدول کاربران -->
<div class="card" style="margin-bottom: 2rem;">
  <h3 style="margin-bottom: 1rem; color: #1e3a8a;">فهرست کاربران سامانه</h3>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>نام و نام خانوادگی</th>
          <th>شماره همراه</th>
          <th>نقش کاربری</th>
          <th>تاریخ عضویت</th>
          <th>وضعیت</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><strong><%= u.full_name %></strong></td>
            <td><%= u.mobile %></td>
            <td><span class="badge badge-blue"><%= u.role_title_fa %></span></td>
            <td><%= toJalaliDate(u.created_at) %></td>
            <td>
              <% if (u.status === 'active') { %>
                <span class="badge badge-green">فعال</span>
              <% } else { %>
                <span class="badge badge-red">غیرفعال</span>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
