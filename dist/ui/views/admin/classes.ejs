<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="color: #1e3a8a;">مدیریت دوره‌ها و کلاس‌های آموزشی</h2>
    <p style="color: #64748b;">تعریف دوره، زمان‌بندی کلاس، تخصیص استاد و پیش‌ثبت‌نام</p>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;">
  <!-- فرم ایجاد دوره جدید -->
  <div class="card">
    <h3 style="margin-bottom: 1rem; color: #1e3a8a;">➕ ایجاد سرفصل دوره جدید</h3>
    <form method="POST" action="/admin/courses/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="courseTitle">عنوان دوره</label>
        <input type="text" id="courseTitle" name="title" required placeholder="مثال: توسعه وب با Node.js">
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="courseCode">کد اختصاری دوره</label>
          <input type="text" id="courseCode" name="code" required placeholder="مثال: CRS-NODE">
        </div>
        <div class="form-group">
          <label for="category">دسته‌بندی</label>
          <input type="text" id="category" name="category" required placeholder="مثال: برنامه‌نویسی">
        </div>
      </div>
      <div class="form-group">
        <label for="level">سطح دوره</label>
        <select id="level" name="level">
          <option value="مقدماتی">مقدماتی</option>
          <option value="متوسط">متوسط</option>
          <option value="پیشرفته">پیشرفته</option>
          <option value="جامع">جامع</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">ثبت دوره جدید</button>
    </form>
  </div>

  <!-- فرم ایجاد کلاس جدید -->
  <div class="card">
    <h3 style="margin-bottom: 1rem; color: #1e3a8a;">➕ تعریف کلاس آموزشی جدید</h3>
    <form method="POST" action="/admin/classes/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="courseId">انتخاب دوره آموزشی</label>
        <select id="courseId" name="courseId" required>
          <% courses.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.title %> (<%= c.code %>)</option>
          <% }); %>
        </select>
      </div>
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="classTitle">عنوان کلاس</label>
          <input type="text" id="classTitle" name="title" required placeholder="کد ۰۱ بهار ۱۴۰۵">
        </div>
        <div class="form-group">
          <label for="classCode">کد کلاس</label>
          <input type="text" id="classCode" name="code" required placeholder="CLS-101">
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="capacity">ظرفیت (نفر)</label>
          <input type="number" id="capacity" name="capacity" value="20" required min="1">
        </div>
        <div class="form-group">
          <label for="tuitionFee">شهریه (تومان)</label>
          <input type="number" id="tuitionFee" name="tuitionFee" value="5000000" required min="0">
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        <div class="form-group">
          <label for="startDate">تاریخ شروع</label>
          <input type="date" id="startDate" name="startDate" required>
        </div>
        <div class="form-group">
          <label for="endDate">تاریخ پایان</label>
          <input type="date" id="endDate" name="endDate" required>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem;">
        <div class="form-group">
          <label for="scheduleDays">روزها</label>
          <input type="text" id="scheduleDays" name="scheduleDays" placeholder="شنبه، چهارشنبه" required>
        </div>
        <div class="form-group">
          <label for="startTime">شروع</label>
          <input type="time" id="startTime" name="startTime" value="18:00" required>
        </div>
        <div class="form-group">
          <label for="endTime">پایان</label>
          <input type="time" id="endTime" name="endTime" value="20:00" required>
        </div>
      </div>
      <div class="form-group">
        <label for="location">محل برگزاری / لینک کلاس</label>
        <input type="text" id="location" name="location" value="آنلاین / سالن اجتماعات" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">ثبت کلاس جدید</button>
    </form>
  </div>
</div>

<!-- جدول کلاس‌ها -->
<div class="card">
  <h3 style="margin-bottom: 1rem; color: #1e3a8a;">فهرست کلاس‌های موجود</h3>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>کد</th>
          <th>عنوان کلاس</th>
          <th>دوره</th>
          <th>استاد(ها)</th>
          <th>برنامه زمانی</th>
          <th>ظرفیت / ثبت‌نام</th>
          <th>شهریه</th>
          <th>وضعیت</th>
          <th>عملیات</th>
        </tr>
      </thead>
      <tbody>
        <% if (classes.length === 0) { %>
          <tr><td colspan="9" style="text-align: center; color: #64748b;">هیچ کلاسی ثبت نشده است.</td></tr>
        <% } %>
        <% classes.forEach(cls => { %>
          <tr>
            <td><code><%= cls.code %></code></td>
            <td><strong><%= cls.title %></strong></td>
            <td><%= cls.course_title %></td>
            <td>
              <% if (cls.teachers && cls.teachers.length > 0) { %>
                <%= cls.teachers.map(t => t.full_name).join('، ') %>
              <% } else { %>
                <span style="color: #94a3b8;">تخصیص‌نیافته</span>
              <% } %>
            </td>
            <td><%= cls.schedule_days %> (<%= cls.start_time %> - <%= cls.end_time %>)</td>
            <td><%= cls.enrolledCount.toLocaleString('fa-IR') %> از <%= cls.capacity.toLocaleString('fa-IR') %></td>
            <td><%= formatCurrency(cls.tuition_fee) %></td>
            <td><span class="badge <%= getStatusBadge(cls.status).class %>"><%= getStatusBadge(cls.status).label %></span></td>
            <td>
              <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <a href="/preregister/<%= cls.id %>" target="_blank" class="btn btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;">لینک ثبت‌نام</a>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
