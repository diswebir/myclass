<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
  <div>
    <h2 style="color: #1e3a8a;">تنظیمات سامانه و مؤسسه</h2>
    <p style="color: #64748b;">اطلاعات تماس، عنوان مؤسسه و کلید اتصال درگاه پیامک</p>
  </div>
</div>

<div class="card" style="max-width: 750px;">
  <form method="POST" action="/admin/settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <h3 style="margin-bottom: 1rem; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">اطلاعات عمومی آموزشگاه</h3>
    
    <div class="form-group">
      <label for="institution_name">نام رسمی آموزشگاه / مؤسسه</label>
      <input type="text" id="institution_name" name="institution_name" value="<%= settings.institution_name || '' %>" required>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="form-group">
        <label for="institution_phone">تلفن تماس ثابت</label>
        <input type="text" id="institution_phone" name="institution_phone" value="<%= settings.institution_phone || '' %>">
      </div>
      <div class="form-group">
        <label for="institution_slogan">شعار مؤسسه</label>
        <input type="text" id="institution_slogan" name="institution_slogan" value="<%= settings.institution_slogan || '' %>">
      </div>
    </div>

    <div class="form-group">
      <label for="institution_address">نشانی آموزشگاه</label>
      <input type="text" id="institution_address" name="institution_address" value="<%= settings.institution_address || '' %>">
    </div>

    <h3 style="margin-top: 2rem; margin-bottom: 1rem; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">تنظیمات درگاه پیامک IPPanel Edge</h3>

    <div class="form-group">
      <label for="ippanel_api_key">کلید دسترسی وب‌سرویس پیامک (API Key)</label>
      <input type="password" id="ippanel_api_key" name="ippanel_api_key" value="<%= settings.ippanel_api_key || '' %>" placeholder="••••••••">
      <small style="color: #64748b;">کلید API دریافت شده از پنل ippanel.com جهت ارسال پترن‌های تایید و اطلاع‌رسانی</small>
    </div>

    <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">ذخیره تنظیمات</button>
  </form>
</div>
