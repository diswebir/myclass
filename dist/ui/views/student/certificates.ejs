<div style="margin-bottom: 2rem;">
  <h2 style="color: #1e3a8a;">گواهینامه‌ها و مدارک پایان‌دوره</h2>
  <p style="color: #64748b;">مدارک رسمی صادرشده با قابلیت استعلام و بارکد هوشمند QR Code</p>
</div>

<div class="card">
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>عنوان مدرک</th>
          <th>دوره آموزشی</th>
          <th>کد رهگیری</th>
          <th>تاریخ صدور</th>
          <th>وضعیت</th>
          <th>بارکد استعلام</th>
        </tr>
      </thead>
      <tbody>
        <% if (certificates.length === 0) { %>
          <tr><td colspan="6" style="text-align: center; color: #64748b;">تاکنون گواهینامه‌ای برای شما صادر نشده است.</td></tr>
        <% } %>
        <% certificates.forEach(c => { %>
          <tr>
            <td><strong><%= c.title %></strong></td>
            <td><%= c.course_title %></td>
            <td><code><%= c.certificate_code %></code></td>
            <td><%= toJalaliDate(c.issue_date) %></td>
            <td><span class="badge <%= getStatusBadge(c.status).class %>"><%= getStatusBadge(c.status).label %></span></td>
            <td>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <a href="/verify/<%= c.certificate_code %>" target="_blank" class="btn btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.8rem;">
                  🔍 استعلام رسمی
                </a>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
